# Configuration with secrets (don't commit raw tokens)
config/mcp.d/sentry.json
config/mcp.d/git.json
config/mcp.d/courtlistener.json
config/mcp.d/e2b.json
config/.security_bootstrap_secret

# Data directories
datasets/
weights/
sensor_data/

# Private financial/legal source documents for agent CAG knowledge bases -
# these are the owner's real records, never meant to leave this machine.
# The whole knowledge_base, not one subdirectory of it.
#
# This said `knowledge_base/accounting_agent/instruments/*` - one path - while
# the scanner and everyone reading the tree assumed the directory was private.
# It was not: 52 files were tracked in a PUBLIC repository, including the
# accounting, trust and legal working directories. Empty placeholders today;
# the first statement, instrument or case document dropped in would have been
# committed by the next `git add -A`.
#
# Generic reference material that genuinely belongs in public lives in
# reference/, which is committed. This is the principal's own working notes.
knowledge_base/
!knowledge_base/accounting_agent/instruments/.gitkeep
knowledge_base/accounting_agent/statements/*
!knowledge_base/accounting_agent/statements/.gitkeep
knowledge_base/accounting_agent/trust_estate/*
!knowledge_base/accounting_agent/trust_estate/.gitkeep
knowledge_base/legal_agent/lessons_learned/*
!knowledge_base/legal_agent/lessons_learned/.gitkeep
knowledge_base/grow_agent/photos/*
!knowledge_base/grow_agent/photos/.gitkeep
knowledge_base/grow_agent/notes/*
!knowledge_base/grow_agent/notes/.gitkeep
# Training images are large binaries supplied by the grower - keep the labelled
# folder structure and the labelling guide, not the photos themselves.
knowledge_base/grow_agent/training/*/*
!knowledge_base/grow_agent/training/*/.gitkeep
!knowledge_base/grow_agent/training/README.md


# Backup and temp files
*.bak
*.swp
*~
/tmp/
.DS_Store

# IDE
.vscode/
.idea/
state/inbox/
state/uploads/
state/courtlistener_cache/
datasets/security_eval/

# Real financial inventory. The repo is public; the data is not.
private/

# Generated analysis OVER LIVE DATA. The six that were tracked are benign -
# system-health recommendations, no identifiers - but reports/ is declared
# sensitive in core/fs_boundary.py, and a directory declared private while
# being committed is the gitignore-covering-one-subdirectory fault again.
# Future analyzer output runs over the financial registries.
reports/
