# Copy to .env before running `docker compose up`. Values here mirror the
# env vars documented in CLAUDE.md.

# Claude models (optional - falls back to local Ollama models if unset)
ANTHROPIC_API_KEY=

# Sentry MCP error monitoring (optional)
SENTRY_ACCESS_TOKEN=

# CourtListener MCP case-law lookups, used by the Legal Agent (optional)
COURTLISTENER_API_TOKEN=

# Default model for the Inference Service
INFERENCE_MODEL=qwen2.5:1.5b

# Keep local Ollama models loaded in memory
OLLAMA_KEEP_ALIVE=5m

# Reaching the principal when he is not looking at the dashboard.
# Anansi owns every outbound channel; no domain agent has one. Without these,
# `notify` reports the email UNSENT with the reason rather than pretending -
# and every reminder the system holds is a note to someone it cannot contact.
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=          # a Gmail App Password, never the account password
NOTIFY_TO=

# Mail arriving. Point this at a DEDICATED address, never the personal inbox -
# a mailbox an agent reads should contain only what was meant for it. Anansi
# files each message and hands the domain a reference; no agent sees the body.
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASS=            # an App Password for the dedicated address
MAIL_IMAP_FOLDER=INBOX

# Solana RPC endpoint for Trading Agent's concentration check.
# The KEYLESS public endpoint will NOT work: api.mainnet-beta.solana.com answers
# getTokenSupply but returns 429 for getTokenLargestAccounts, and ankr, rpcpool
# and publicnode return 403 for both (measured 2026-09-05, six endpoints).
# Any provider's free tier with a key serves it. Paste the full URL including
# the key. Falls back to the public endpoint, which fails closed.
# SOLANA_RPC_URL=https://<provider-host>/<your-key>
