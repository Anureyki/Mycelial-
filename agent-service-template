[Unit]
Description=Mycelial Agent: %i
After=network.target

[Service]
Type=simple
User=anureyki
WorkingDirectory=/home/anureyki/mycelial
ExecStart=/home/anureyki/mycelial/venv/bin/python /home/anureyki/mycelial/agents/%i.py --serve
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
