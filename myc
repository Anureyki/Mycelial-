#!/usr/bin/env python3
"""Unified Mycelial Command Interface"""
import sys
import subprocess
import os

BASE = os.path.expanduser("~/mycelial")

def show_help():
    print("""
🍄 Mycelial Network – Command Interface

Commands:
  myc status              - Check all services
  myc chat                - Chat with Boss Agent
  myc train [agent]       - Train an agent (ag_agent, boss_agent)
  myc heal                - Run self-healer
  myc dashboard           - Open dashboard (port 7001)
  myc sources             - Run source monitor
  myc security            - Run security audit
  myc dqn                 - Run DQN decision on sensor data
  myc help                - Show this help

Examples:
  myc status              # Check everything
  myc train ag_agent      # Train the agriculture DQN
  myc chat                # Talk to Boss with DeepSeek
    """)

def main():
    if len(sys.argv) < 2:
        show_help()
        return
    
    cmd = sys.argv[1]
    
    if cmd == "status":
        subprocess.call(["sudo", "systemctl", "status", "boss-agent", "dashboard", "fl-server"])
    
    elif cmd == "chat":
        subprocess.call(["/home/anureyki/AgTechAI/venv/bin/python", os.path.join(BASE, "chat.py")])
    
    elif cmd == "train" and len(sys.argv) > 2:
        agent = sys.argv[2]
        if agent == "ag_agent":
            subprocess.call(["/home/anureyki/AgTechAI/venv/bin/python", os.path.join(BASE, "agents", "ag_agent", "agriculture_agent.py"), "--task", "dqn_train"])
        else:
            print(f"⚠️ Unknown agent: {agent}")
    
    elif cmd == "heal":
        subprocess.call(["/home/anureyki/AgTechAI/venv/bin/python", os.path.join(BASE, "agents", "self_healer.py")])
    
    elif cmd == "dashboard":
        subprocess.call(["xdg-open", "http://localhost:7001"])
    
    elif cmd == "sources":
        subprocess.call(["/home/anureyki/AgTechAI/venv/bin/python", os.path.join(BASE, "agents", "source_monitor.py"), "--task", "monitor"])
    
    elif cmd == "security":
        subprocess.call(["/home/anureyki/AgTechAI/venv/bin/python", os.path.join(BASE, "agents", "security_agent", "security_agent.py"), "--task", "scan"])
    
    elif cmd == "dqn":
        subprocess.call(["/home/anureyki/AgTechAI/venv/bin/python", os.path.join(BASE, "agents", "ag_agent", "agriculture_agent.py"), "--task", "dqn_decide"])
    
    else:
        show_help()

if __name__ == "__main__":
    main()
