        crop = args.args[1] if args.args and len(args.args) > 1 else "cannabis"
        success = fl_orchestrate(mode, crop)
    elif task == "show_pending":
    elif task == "fl_orchestrate":
        mode = args.args[0] if args.args and len(args.args) > 0 else "synth"
        crop = args.args[1] if args.args and len(args.args) > 1 else "cannabis"
